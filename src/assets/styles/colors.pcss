:root {
  /* ========== Base Colors ========== */
  --black: #000;
  --white: #fff;

  --gray-900: #0a0a0a;
  --gray-850: #0f0f0f;
  --gray-800: #1a1a1a;
  --gray-750: #1e1e1e;
  --gray-650: #252525;
  --gray-600: #2a2a2a;

  --gray-300: #b3b3b3;
  --gray-280: #b0b0b0;
  --gray-250: #bbb;
  --gray-220: #ccc;
  --gray-200: #ddd;

  --gray-180: #aaa;
  --gray-150: #888;

  --border-dark: #444;
  --border-medium: #333;
  --border-light: #222;

  --accent: #0066ff;
  --accent-bright: #3388ff;
  --accent-hover: #0052cc;

  /* ========== Semantic Colors ========== */
  /* Backgrounds */
  --bg-primary: var(--gray-850);
  --bg-secondary: var(--gray-900);
  --bg-card: var(--gray-750);
  --bg-card-hover: var(--gray-650);
  --bg-tech-tag: var(--gray-600);
  --bg-filter-btn: var(--gray-750);
  --bg-about-card: var(--gray-900);
  --bg-technique-card: var(--gray-750);
  --bg-hero-item: var(--gray-750);
  --bg-contact-note: var(--gray-800);
  --bg-modal-overlay: rgba(0, 0, 0, 0.8);
  --bg-nav-overlay: rgba(var(--bg-primary), 0.95);
  --bg-gradient-start: var(--bg-secondary);
  --bg-gradient-end: var(--gray-800);

  /* Accent Variants */
  --accent-bg-light: rgba(0, 102, 255, 0.15);
  --accent-border-light: rgba(0, 102, 255, 0.3);

  /* Text Colors */
  --text-primary: var(--gray-200);
  --text-secondary: var(--gray-280);
  --text-muted: var(--gray-150);
  --text-link: var(--gray-200);
  --text-link-hover: var(--white);
  --text-modal-title: var(--white);
  --text-modal-close: var(--gray-180);
  --text-project-desc: var(--gray-300);
  --text-tech-tag: var(--gray-180);
  --text-filter-btn: var(--gray-220);
  --text-filter-btn-hover: var(--white);
  --text-about-heading: var(--gray-220);
  --text-contact-note: var(--gray-250);

  /* Borders */
  --border-primary: var(--border-light);
  --border-accent: var(--accent);
  --border-tech-tag: var(--border-dark);
  --border-filter-btn: var(--border-medium);
  --border-filter-btn-active: var(--accent);
  --border-hero-item: var(--border-dark);

  /* Shadows */
  --shadow-color: rgba(0, 0, 0, 0.5);
  --shadow-card: rgb(0 0 0 / 0.3);

  /* Special */
  --spinner-color: var(--accent);

  /* Modal Content Background */
  --white-modal: #ffffff;
}
